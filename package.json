{
  "name": "octanemcpplus",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server & 2021 Luau Studio plugin for Octane",
  "main": "src/index.js",
  "bin": {
    "octane-mcp": "./src/index.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/OctaneUtils/OctaneMCPPlus.git"
  },
  "files": [
    "src",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.js",
    "test": "bun test",
    "status": "bun run tests/cli-status.js",
    "validate": "mcpb validate manifest.json",
    "pack": "mcpb pack . octane-mcp.mcpb",
    "postinstall": "node scripts/patch-elysia.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "octane",
    "roblox",
    "luau",
    "elysia",
    "bun",
    "ai",
    "cursor",
    "claude",
    "antigravity"
  ],
  "author": "omnifla",
  "license": "MIT",
  "dependencies": {
    "@elysiajs/node": "^1.4.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "elysia": "^1.4.30",
    "elysia-mcp": "^0.1.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2"
  }
}
